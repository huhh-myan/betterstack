# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# Postgres connection (same database as the worker and pusher).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bstack"

# Signs login tokens (HS256). At least 32 random characters. Generate one:
#   bun -e "console.log(crypto.randomUUID().replaceAll('-','') + crypto.randomUUID().replaceAll('-',''))"
JWT_SECRET=

# Comma-separated usernames that become admins (can create regions and
# approve region requests). Applied when the API starts and on signup.
ADMIN_USERNAMES=admin

# Optional
# PORT=3000
# TOKEN_TTL=2h
# LOG_SQL=1
