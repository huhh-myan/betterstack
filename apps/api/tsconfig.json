{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
  //   // Environment setup & latest features
    "lib": ["ESNext"],
  //   "target": "ESNext",
    "module": "Preserve",
  //   "moduleDetection": "force", --- ALREADY IN @repo/typescript-config/base.json
    "types": ["bun"],

  //   // Bundler mode
    "moduleResolution": "bundler",
    //allows of importing .ts directly
    "allowImportingTsExtensions": true,
    //makes you allow use of types in import statements
    "verbatimModuleSyntax": true,
    "noEmit": true,

  //   // Best practices ---- ALREADY IN @repo/typescript-config/base.json
  //   "strict": true,
  //   "skipLibCheck": true,
  //   "noUncheckedIndexedAccess": true,

  //   "noFallthroughCasesInSwitch": true,
  //   "noImplicitOverride": true,

  //   // Some stricter flags (disabled by default)
  //   "noUnusedLocals": false,
  //   "noUnusedParameters": false,
  //   "noPropertyAccessFromIndexSignature": false
  }
}
