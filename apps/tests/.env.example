# Copy to .env. Tests write users, websites and regions, so point them at a
# separate database, never your real one:
#   docker exec -it rocky_road psql -U postgres -c "CREATE DATABASE bstack_test;"
#   then apply migrations to it (see README.md).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bstack_test"

# Any 32+ character string; only used to sign tokens during the tests.
JWT_SECRET=test-secret-test-secret-test-secret-1234
