# Where the Express API (apps/api) is running. Requests to /api/* on this app
# are forwarded there, so the browser never calls it cross-origin.
API_URL=http://localhost:3000

# 1 = run the whole UI on in-browser mock data (no backend needed, any
# username/password works). 0 or unset = use the real API, with simulated
# ticks for the parts the API doesn't expose yet.
NEXT_PUBLIC_MOCK=0
